# ============================================================
# Lumora configuration. Copy to `.env` (never commit `.env`).
# The backend reads these from the environment (or backend/.env).
# ============================================================

# --- Core ---------------------------------------------------
ENVIRONMENT=development            # development | test | production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# --- Database -----------------------------------------------
# Docker compose builds this from POSTGRES_PASSWORD. For a local backend:
#   PostgreSQL: postgresql+psycopg://lumora:password@localhost:5432/lumora
#   SQLite (quick start, no pgvector): sqlite:///./lumora.db
DATABASE_URL=postgresql+psycopg://lumora:lumora-local-only@localhost:5432/lumora
POSTGRES_PASSWORD=lumora-local-only

# --- HTTP ---------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- AI provider --------------------------------------------
# demo      = offline, deterministic, grounded answers (no key needed)
# openai    = OpenAI chat completions with JSON-schema structured outputs
# anthropic = Claude with structured outputs
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=                          # optional; defaults: gpt-4.1-mini / claude-opus-5-5

# --- RAG embeddings -----------------------------------------
# local  = offline feature-hashing embeddings (384-dim)
# openai = text-embedding-3-small (dimensions=384)
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=

# --- Seeding ------------------------------------------------
SEED_DEMO_USER=true                # creates demo@lumora.app with SIMULATED history
